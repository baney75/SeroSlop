  "training": {
    "epochs": 12,
    "batchSize": 2048,
    "featureBatchSize": 24,
    "featureShardImages": 2000,
    "optimizer": "AdamW",
    "sourceBalancedLoss": "global view weights give each class relative mass 0.5 and every named source equal mass within its class; each minibatch uses its global weights without renormalization and applies one fixed ceil(totalViews / batchSize) scale; every extracted view appears once per epoch",
    "anchorLoss": "global mean squared error between candidate and frozen M2 logits over protectedAnchorSources only; each minibatch divides by the fixed total protected-view count, applies the same fixed batch-count scale, and multiplies by the candidate anchor coefficient",
    "batchOrdering": "torch.Generator.manual_seed(seed + epoch), then torch.randperm over every training feature view exactly once",
    "initializationRng": "torch.manual_seed(seed) before kaiming_uniform_ for adapter_in.weight; all biases and adapter_out.weight are exact zeros",
    "learningRate": 0.003,
    "weightDecays": [0.003, 0.01, 0.03],
    "anchorCoefficients": [0.01, 0.03, 0.1, 0.3],
    "candidateCount": 12,
    "executionProvider": "cpu",
    "freshFeatureExtractionRequired": true,
    "displayThreshold": 0.65
  },
  "selectionPolicy": {
    "thresholdEnumeration": "all finite binary64 decision partitions using each unique logit and math.nextafter(logit, +infinity), plus the below-minimum boundary",
    "candidateRanking": "selector gates first; then lexicographic maximum of worstVariantBalancedAccuracy, worstVariantRealRecall, worstVariantSyntheticRecall, worstFamilySyntheticRecall, worstRequiredRealSourceRecall, negativeWeightDecay, negativeAnchorCoefficient",
